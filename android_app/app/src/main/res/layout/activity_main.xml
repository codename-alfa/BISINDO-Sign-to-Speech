<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ======================================================== -->
    <!-- ARAH 1: TULI -> DENGAR (Kamera + Edge AI + TTS)          -->
    <!-- ======================================================== -->

    <!-- Layer 1: CameraX Fullscreen Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Layer 2: Custom Landmark & Skeleton Overlay -->
    <com.signtospeech.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 3: Top HUD & Mode/Delegate Segmented Controls -->
    <LinearLayout
        android:id="@+id/badgeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="32dp"
        android:background="@color/badge_bg"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <!-- Row 1: Hand Detection Status + Detailed HUD Latency Metrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_searching"
                android:textColor="@color/landmark_point"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="8dp"
                android:background="#44FFFFFF" />

            <TextView
                android:id="@+id/tvFps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="FPS: -- · MP: -- ms · Cls: -- ms · CPU"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Row 2: Mode Toggle (Huruf | Kata) & Delegate Toggle (CPU | GPU) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Mode Selector: Huruf | Kata -->
            <TextView
                android:id="@+id/btnModeLetter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/chip_active_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/mode_letter"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnModeWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:background="@color/chip_inactive_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/mode_word"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Delegate Selector: CPU | GPU -->
            <TextView
                android:id="@+id/btnDelegateCpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/chip_active_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/delegate_cpu"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDelegateGpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:background="@color/chip_inactive_bg"
                android:clickable="true"
                android:focusable="true"
                android:longClickable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/delegate_gpu"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Layer 4: Switch Camera Button (Above Bottom Panel) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnSwitchCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="252dp"
        android:contentDescription="Switch Camera"
        app:backgroundTint="#263238"
        app:elevation="6dp"
        app:fabSize="mini"
        app:srcCompat="@android:drawable/ic_menu_rotate"
        app:tint="@color/white" />

    <!-- Layer 5: Bottom Prediction, Confidence & Transcript Panel -->
    <LinearLayout
        android:id="@+id/predictionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:background="@color/panel_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Transcript Row + Clear + TTS Mute Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTranscript"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="start"
                android:singleLine="true"
                android:text="@string/transcript_placeholder"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearTranscript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@color/chip_inactive_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/clear_transcript"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnMuteTts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@color/chip_active_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/tts_on"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#33FFFFFF" />

        <!-- Main Prediction Label & Confidence Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPredictionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:text="—"
                android:textColor="@color/landmark_point"
                android:textSize="34sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvConfidencePercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/waiting_gesture"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/progressConfidence"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/landmark_point" />

                <TextView
                    android:id="@+id/tvSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/confidence_low"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- ARAH 2: DENGAR -> TULI (Mikrofon + STT + Visual Cards)   -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/arah2Container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        android:background="@color/color_arah2_bg"
        android:elevation="7dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/arah2_title"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvArah2ModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/chip_inactive_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/arah2_mode_offline"
                android:textColor="@color/landmark_point"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnArah2Manual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@color/chip_active_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/arah2_manual_input"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnArah2Clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@color/chip_inactive_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/arah2_clear"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Quick Presets Horizontal Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llQuickPresets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Main Display Scrollable Area -->
        <ScrollView
            android:id="@+id/scrollArah2Content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Audio Level Meter -->
                <ProgressBar
                    android:id="@+id/progressAudioLevel"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginVertical="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/color_audio_level" />

                <!-- Status & Instruction -->
                <TextView
                    android:id="@+id/tvSpeechStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/arah2_instruction"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <!-- Large High-Contrast Transcript Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/color_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSpeechTranscript"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="6dp"
                        android:text="@string/arah2_placeholder"
                        android:textColor="@color/white"
                        android:textIsSelectable="true"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Visual Assistance Cards Container -->
                <TextView
                    android:id="@+id/tvCardsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="Bantuan Konteks Visual (Layanan Publik):"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llVisualCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Space for scroll bottom -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Mic Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161F30"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <LinearLayout
                android:id="@+id/btnToggleMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/color_mic_idle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tvMicIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎤"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvMicLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/arah2_tap_to_start"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- PERSISTENT BOTTOM NAVIGATION (Arah 1 <-> Arah 2 Switcher)-->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/bottomNavDirection"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="#0F172A"
        android:elevation="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabArah1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTabArah1Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤟 Isyarat ➔ Suara"
                android:textColor="@color/color_nav_active"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicatorTabArah1"
                android:layout_width="36dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@color/color_nav_active" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:background="#334155" />

        <LinearLayout
            android:id="@+id/tabArah2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTabArah2Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤 Suara ➔ Teks"
                android:textColor="@color/color_nav_inactive"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicatorTabArah2"
                android:layout_width="36dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>

    <!-- Layer: Fallback Permission View (hidden by default) -->
    <LinearLayout
        android:id="@+id/permissionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_surface"
        android:elevation="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/camera_permission_required"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/landmark_point"
            android:text="@string/grant_permission"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
