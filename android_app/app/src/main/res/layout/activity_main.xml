<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ======================================================== -->
    <!-- ARAH 1: TULI -> DENGAR (Kamera + Edge AI + TTS)          -->
    <!-- ======================================================== -->

    <!-- Layer 1: CameraX Fullscreen Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Layer 2: Custom Landmark & Skeleton Overlay -->
    <com.signtospeech.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 3: Top HUD & Figma Segmented Pill Controls -->
    <LinearLayout
        android:id="@+id/badgeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="@dimen/top_safe_margin"
        android:elevation="6dp"
        android:orientation="vertical">

        <!-- Row 1: Coherent Floating Status & Latency Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_figma_hud_status"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_searching"
                android:textColor="@color/landmark_point"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/divider_hud" />

            <TextView
                android:id="@+id/tvFps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="FPS: -- · MP: -- ms · Cls: -- ms · CPU"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Row 2: Figma Pill Toggles (Huruf | Kata) & (CPU | GPU) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Mode Selector Pill (#0E385C outer + #008CE3 active) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_figma_pill_container"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnModeLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_figma_pill_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="58dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="5dp"
                    android:text="@string/mode_letter"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnModeWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="5dp"
                    android:text="@string/mode_word"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Delegate Selector Pill (CPU | GPU) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_figma_pill_container"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDelegateCpu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_figma_pill_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="46dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="@string/delegate_cpu"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDelegateGpu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:longClickable="true"
                    android:minWidth="46dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="@string/delegate_gpu"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Layer 4: Switch Camera Button (Figma #23:315 Light Circle + Dark Icon) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnSwitchCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="208dp"
        android:contentDescription="Switch Camera"
        app:backgroundTint="@color/fab_switch_camera_bg"
        app:elevation="6dp"
        app:fabSize="mini"
        app:srcCompat="@android:drawable/ic_menu_rotate"
        app:tint="#18181B" />

    <!-- Layer 5: Bottom Prediction, Confidence & Transcript Panel (Figma #23:291 #D9000D27) -->
    <LinearLayout
        android:id="@+id/predictionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/panel_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="56dp">

        <!-- Transcript Row + Delete Last (Hapus) + Clear All (Clear) + TTS Mute Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTranscript"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="start"
                android:fontFamily="@font/inter_regular"
                android:singleLine="true"
                android:text="@string/transcript_placeholder"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnDeleteLastTranscript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_figma_action_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/delete_last_transcript"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearTranscript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_figma_action_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/clear_transcript"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMuteTts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_figma_sound_on"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/tts_on"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Figma White Horizontal Line (#23:311) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/divider_subtle" />

        <!-- Main Prediction Label & Confidence Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPredictionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:minWidth="72dp"
                android:text="—"
                android:textColor="@color/landmark_point"
                android:textSize="@dimen/text_size_prediction_main"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvConfidencePercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/waiting_gesture"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/progressConfidence"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/landmark_point" />

                <TextView
                    android:id="@+id/tvSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/confidence_low"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <!-- Interactive Quick Suggestion Chips (Self-Correction Huruf <-> Angka) -->
                <LinearLayout
                    android:id="@+id/llQuickSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- ARAH 2: DENGAR -> TULI (Mikrofon + STT + Visual Cards)   -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/arah2Container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_arah2_bg"
        android:elevation="7dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Floating Status HUD (Coherent with Arah 1 bg_figma_hud_status) -->
        <LinearLayout
            android:id="@+id/hudArah2Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/top_safe_margin"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_figma_hud_status"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp">

            <View
                android:id="@+id/hudArah2Dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_figma_pill_active"
                android:backgroundTint="@color/landmark_point" />

            <TextView
                android:id="@+id/tvSpeechStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:singleLine="true"
                android:text="@string/arah2_instruction"
                android:textColor="@color/landmark_point"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/divider_hud" />

            <TextView
                android:id="@+id/tvArah2ModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_figma_action_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_semibold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/arah2_mode_offline"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <View
                android:id="@+id/btnArah2DebugLog"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Main Display Scrollable Area -->
        <ScrollView
            android:id="@+id/scrollArah2Content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:paddingHorizontal="@dimen/screen_horizontal_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Signature Object: High-Contrast 28sp Transcript Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_figma_card_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Row: Label + Edit + Clear -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_semibold"
                            android:text="@string/arah2_transkrip_label"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnArah2Edit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_figma_action_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="@string/arah2_edit"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnArah2Clear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_figma_action_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="@string/arah2_clear"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Large High-Contrast Transcript Box -->
                    <TextView
                        android:id="@+id/tvSpeechTranscript"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/inter_bold"
                        android:lineSpacingExtra="6dp"
                        android:text="@string/arah2_placeholder"
                        android:textColor="@color/white"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/text_size_arah2_transcript"
                        android:textStyle="bold" />

                    <!-- Sleek Audio Level Meter at the base of the transcript card -->
                    <ProgressBar
                        android:id="@+id/progressAudioLevel"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/landmark_point" />
                </LinearLayout>

                <!-- Contextual Visual Assistance Cards Header & Container -->
                <TextView
                    android:id="@+id/tvCardsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Kartu bantuan visual:"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llVisualCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Space for scroll bottom -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Action Deck (Deck Input: Presets + Keyboard + Mic + Toggle Arah) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/panel_bg"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal_padding"
            android:paddingTop="10dp"
            android:paddingBottom="56dp">

            <!-- Row 1: Quick Preset Chips Strip (Relocated per Decision Q4) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llQuickPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Row 2: Inline Keyboard Input + Submit Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etArah2KeyboardInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_arah2_keyboard_input"
                    android:fontFamily="@font/inter_regular"
                    android:hint="@string/arah2_input_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences"
                    android:maxLines="3"
                    android:minHeight="@dimen/input_min_height"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_muted"
                    android:textSize="@dimen/text_size_input" />

                <TextView
                    android:id="@+id/btnSubmitKeyboard"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/input_min_height"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_arah2_btn_submit"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/arah2_btn_submit"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Exact Figma White Horizontal Divider Line (#23:311 in Arah 1) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/divider_subtle" />

            <!-- Row 3: Circular Microphone Action Button (56dp, No Text) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnToggleMic"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_figma_mic_idle"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMicIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Mikrofon"
                        android:src="@drawable/ic_mic_24dp"
                        app:tint="@color/white" />

                    <!-- Hidden tvMicIcon & tvMicLabel for backwards compatibility -->
                    <TextView
                        android:id="@+id/tvMicIcon"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvMicLabel"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- PERSISTENT BOTTOM NAVIGATION PILL (Figma #23:305 Style)  -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/bottomNavDirection"
        android:layout_width="270dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_figma_bottom_toggle_container"
        android:elevation="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabArah1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_figma_bottom_toggle_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTabArah1Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_light_italic"
                android:includeFontPadding="false"
                android:text="@string/direction_arah1"
                android:textColor="@color/figma_toggle_active_text"
                android:textSize="12sp"
                android:textStyle="italic" />

            <View
                android:id="@+id/indicatorTabArah1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabArah2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTabArah2Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold_italic"
                android:includeFontPadding="false"
                android:text="@string/direction_arah2"
                android:textColor="@color/figma_toggle_inactive_text"
                android:textSize="12sp"
                android:textStyle="italic" />

            <View
                android:id="@+id/indicatorTabArah2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Layer: Fallback Permission View (hidden by default) -->
    <LinearLayout
        android:id="@+id/permissionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_surface"
        android:elevation="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/camera_permission_required"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/landmark_point"
            android:text="@string/grant_permission"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- FIGMA LOADING PAGE OVERLAY (Exact #22:282 "splash")      -->
    <!-- ======================================================== -->
    <FrameLayout
        android:id="@+id/loadingSplashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_bg"
        android:clickable="true"
        android:elevation="30dp"
        android:focusable="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="bottom"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="141dp"
                android:layout_height="172dp"
                android:contentDescription="SignToSpeech Hand Skeleton Logo"
                android:src="@drawable/ic_figma_splash_hand" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="-6dp"
                    android:text="Sign To"
                    android:textColor="@color/white"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:includeFontPadding="false"
                    android:text="Speech"
                    android:textColor="@color/white"
                    android:textSize="34sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
