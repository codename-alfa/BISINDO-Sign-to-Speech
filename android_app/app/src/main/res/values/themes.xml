<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SignToSpeech" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/landmark_point</item>
        <item name="colorPrimaryVariant">@color/landmark_connection</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <!-- Splash Screen Theme (AndroidX Core SplashScreen) -->
    <style name="Theme.SignToSpeech.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SignToSpeech</item>
    </style>
</resources>
